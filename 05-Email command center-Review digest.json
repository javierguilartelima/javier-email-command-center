    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [];\n}\n\nconst lines = items.map((item, index) => {\n  const subject =\n    item.json.Subject ||\n    item.json.subject ||\n    '(No subject)';\n\n  const from =\n    item.json.From ||\n    item.json.from ||\n    '(Unknown sender)';\n\n  const snippet =\n    item.json.snippet ||\n    '(No preview)';\n\n  return `${index + 1}. ${subject}\nFrom: ${from}\nPreview: ${snippet}`;\n});\n\nreturn [\n  {\n    json: {\n      review_count: items.length,\n      review_digest: `📋 Emails requiring review: ${items.length}\n\n${lines.join('\\n\\n')}`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
